# ═══════════════════════════════════════════════════════════════════════
#  EHB Development 2026 — Environment Variables Template
#  Copy this file to .env.local and fill in actual values. NEVER commit .env.
# ═══════════════════════════════════════════════════════════════════════

# ── Ports ──────────────────────────────────────────────────────────────
WEB_PORT=3000
API_PORT=5000
AI_PORT=8080
ADMIN_PORT=3001

# ── Database ───────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/ehb

# ── Auth ───────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=24h

# ── External services ──────────────────────────────────────────────────
OPENAI_API_KEY=
POLKADOT_RPC_URL=wss://rpc.polkadot.io

# ── Frontend (public, prefixed NEXT_PUBLIC_*) ──────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_AI_URL=http://localhost:8080
NEXT_PUBLIC_APP_ENV=local

# ── Feature flags ──────────────────────────────────────────────────────
ENABLE_BLOCKCHAIN=false
ENABLE_PSS_LIVENESS=false
