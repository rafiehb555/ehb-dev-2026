# Required for durable shared app data such as JPS imports and future admin-managed datasets.
DATABASE_URL=
EHB_AUTH_SECRET=
NEXT_PUBLIC_APP_ENV=development
# Public base URL for Stripe success/cancel redirects (also set on Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000

EHB_MEMORY_OPENAI_KEY=
EHB_MEMORY_MODEL=gpt-4.1-mini
# Optional: static trusted context fed to the memory brain
EHB_MEMORY_CONTEXT=
# Optional: override default read-only system prompt
EHB_MEMORY_SYSTEM_PROM=

# Stripe (optional — if STRIPE_SECRET_KEY is set, Checkout replaces demo wallet on POST .../pay)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional; default usd
STRIPE_CHECKOUT_CURRENCY=usd

# Vercel Cron / manual GET to /api/jobs/escrow-release-scan: ?secret= or Authorization: Bearer
CRON_SECRET=
CRON_ACTOR_ID=

# When not production: allow API access as demo Super Admin without logging in (default on).
# Set to false to test real auth flows locally.
# EHB_DEV_AUTH_BYPASS=false
