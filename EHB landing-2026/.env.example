# Required for durable shared app data such as JPS imports and future admin-managed datasets.
DATABASE_URL=
EHB_AUTH_SECRET=
NEXT_PUBLIC_APP_ENV=development
EHB_MEMORY_OPENAI_KEY=
EHB_MEMORY_MODEL=gpt-4.1-mini
# Optional: static trusted context fed to the memory brain
EHB_MEMORY_CONTEXT=
# Optional: override default read-only system prompt
EHB_MEMORY_SYSTEM_PROM=

# When not production: allow API access as demo Super Admin without logging in (default on).
# Set to false to test real auth flows locally.
# EHB_DEV_AUTH_BYPASS=false

