{
  "name": "ehb-landing-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"try { require('fs').rmSync('.next', { recursive: true, force: true }); console.log('Removed .next'); } catch (e) { if (e.code !== 'ENOENT') throw e; }\"",
    "clean:all": "node -e \"const fs=require('fs');['.next','node_modules/.cache'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true});console.log('Removed',p)}catch(e){if(e.code!=='ENOENT')throw e}})\"",
    "clean-all": "npm run clean:all",
    "dev": "next dev -p 3000",
    "dev:live": "node scripts/kill-port.cjs 3000 && next dev -p 3000",
    "dev:fresh": "node scripts/kill-port.cjs 3000 && npm run clean:all && next dev -p 3000",
    "dev:clean": "npm run clean && next dev -p 3000",
    "dev:open": "start http://localhost:3000 && next dev -p 3000",
    "build": "next build",
    "test": "vitest run",
    "start": "next start",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "bcryptjs": "^3.0.2",
    "framer-motion": "^12.23.12",
    "jose": "^6.1.0",
    "lucide-react": "^0.577.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "^22.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.16.1",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.2"
  }
}
